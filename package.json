{
  "name": "prototype-agent-whatsapp",
  "version": "1.0.14",
  "private": true,
  "type": "module",
  "description": "Prototipo de comunicación WhatsApp con agente Big Pickle de OpenCode",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"yarn workspace backend-dev dev\" \"yarn workspace frontend-dev dev\"",
    "build": "yarn workspace backend-dev build && yarn workspace frontend-dev build",
    "start": "bun run scripts/start.js",
    "test": "yarn workspace backend-dev test",
    "release": "./release.sh",
    "release:backend": "dotenv -e .env -- yarn workspace backend-dev release"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.14.24",
    "@types/ws": "^8.5.10",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-basic-auth": "^1.2.1",
    "qrcode": "^1.5.4",
    "sql.js": "^1.14.1",
    "whatsapp-web.js": "1.23.0",
    "ws": "^8.20.0"
  },
  "keywords": [
    "whatsapp",
    "opencode",
    "big-pickle",
    "agent",
    "api"
  ],
  "author": "joneldiablo",
  "license": "ISC",
  "devDependencies": {
    "puppeteer": "22.15.0"
  }
}
